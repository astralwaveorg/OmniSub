+def inline_clash_subscriptions(raw, params, parts):
+    """Materialize the synthetic data providers for the existing public template."""
+    result = yaml.safe_load(raw)
+    providers = result.get("proxy-providers")
+    if not providers:
+        return raw
+
+    message = "站点模板无法安全展开这组 Mihomo 节点，已停止生成。"
+    data_sources = {part for part in parts if part.startswith("data:text/plain;base64,")}
+    check(isinstance(providers, dict) and all(
+        isinstance(entry, dict) and entry.get("type") == "http" and entry.get("url") in data_sources
+        for entry in providers.values()
+    ), message)
+
+    # public.ini has one select group matching every supplied node, then DIRECT.
+    # If the template changes, don't silently rewrite any more complex groups.
+    groups = result.get("proxy-groups")
+    check(isinstance(groups, list) and len(groups) == 1 and isinstance(groups[0], dict), message)
+    group = groups[0]
+    direct_names = [node["name"] for node in result.get("proxies", [])]
+    check(group.get("type") == "select" and group.get("filter") == ".*"
+          and set(group.get("use") or []) == set(providers)
+          and group.get("proxies") == direct_names + ["DIRECT"], message)
+
+    inline = yaml.safe_load(request_engine({**params, "list": "true"}))
+    rows = inline.get("proxies")
+    check(isinstance(rows, list) and all(
+        isinstance(node, dict) and isinstance(node.get("name"), str) for node in rows
+    ), message)
+    names = [node["name"] for node in rows]
+    check(len(set(names)) == len(names) and group.get("name") not in names
+          and "DIRECT" not in names, message)
+    group["proxies"] = names + ["DIRECT"]
+    del group["use"], group["filter"], result["proxy-providers"]
+    result["proxies"] = rows
+    out = yaml.safe_dump(result, allow_unicode=True, sort_keys=False).encode()
+    check(len(out) <= 3_000_000, "转换结果过大。")
+    return out
+
+
